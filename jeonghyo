    function autoRotateOverlay() {
      if (isAutoRotating) {
        cancelAnimationFrame(rotateAnimId);
        isAutoRotating = false;
        document.getElementById('autoRotateBtnText').textContent = '빙글 회전하여 포개기';
        document.getElementById('autoRotateIcon').textContent = '▶';
        return;
      }

      isAutoRotating = true;
      document.getElementById('autoRotateBtnText').textContent = '일시 정지';
      document.getElementById('autoRotateIcon').textContent = '⏸';

      if (rotateDeg >= TARGET_OVERLAP_DEG) {
        rotateDeg = 0;
      }

      function step() {
        if (!isAutoRotating) return;
        rotateDeg += 1.5;
        if (rotateDeg >= TARGET_OVERLAP_DEG) {
          rotateDeg = TARGET_OVERLAP_DEG;
          setSectorRotation(rotateDeg);
          isAutoRotating = false;
          document.getElementById('autoRotateBtnText').textContent = '다시 회전하기';
          document.getElementById('autoRotateIcon').textContent = '↺';
          return;
        }
        setSectorRotation(rotateDeg);
        rotateAnimId = requestAnimationFrame(step);
      }
      rotateAnimId = requestAnimationFrame(step);
    }

    function resetRotate() {
      if (isAutoRotating) {
        cancelAnimationFrame(rotateAnimId);
        isAutoRotating = false;
        document.getElementById('autoRotateBtnText').textContent = '빙글 회전하여 포개기';
        document.getElementById('autoRotateIcon').textContent = '▶';

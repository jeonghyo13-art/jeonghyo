    function updateEqualChordSim(degVal) {
      equalChordAngle = parseFloat(degVal);
      const spanRad = (equalChordAngle * Math.PI) / 180;
      const chordLenCm = (2 * 10 * Math.sin(spanRad / 2)).toFixed(1);

      // 상단 우측 실시간 배지 업데이트 (모드에 따라 중심각 또는 현의 길이 표시)
      const topBadge = document.getElementById('topAngleLiveBadge');
      if (topBadge) {
        if (equalChordMode === 'angleToChord') {
          topBadge.textContent = `${Math.round(equalChordAngle)}°`;
        } else {
          topBadge.textContent = `${chordLenCm} cm`;
        }
      }

      const angleLabel = document.getElementById('equalAngleLabel');
      if (angleLabel) {
        if (equalChordMode === 'angleToChord') {
          angleLabel.textContent = `${Math.round(equalChordAngle)}°`;
          angleLabel.className = 'text-indigo-600 text-sm font-extrabold';
        } else {
          angleLabel.textContent = `${chordLenCm} cm (중심각 ${Math.round(equalChordAngle)}°)`;
          angleLabel.className = 'text-emerald-600 text-sm font-extrabold';
        }
      }
      document.querySelectorAll('.curAngText').forEach(el => el.textContent = `${Math.round(equalChordAngle)}°`);

      const layer = document.getElementById('equalChordShapesLayer');
      if (!layer) return;
      layer.innerHTML = '';

      const toRad = deg => (deg * Math.PI) / 180;

      // Sector 1: AOB (Start angle 200°)
      const angA = toRad(200);
      const angB = angA + spanRad;
      const ptA = polarToXY(CX, CY, R, angA);
      const ptB = polarToXY(CX, CY, R, angB);

      // Sector 2: COD (Normally start angle 20°, if overlap active -> rotated onto AOB)
      const baseAngC = toRad(20);
      const angC = isEqualOverlapActive ? angA : baseAngC;
      const angD = angC + spanRad;
      const ptC = polarToXY(CX, CY, R, angC);
      const ptD = polarToXY(CX, CY, R, angD);

      const isMode2 = (equalChordMode === 'chordToAngle');

      // Sector AOB
      const pathAOB = `M ${CX} ${CY} L ${ptA.x} ${ptA.y} A ${R} ${R} 0 0 1 ${ptB.x} ${ptB.y} Z`;
      layer.innerHTML += `
        <path d="${pathAOB}" fill="rgba(99, 102, 241, 0.22)" stroke="#4f46e5" stroke-width="2" />
        <!-- 현 AB 선분 강조 -->
        <line x1="${ptA.x}" y1="${ptA.y}" x2="${ptB.x}" y2="${ptB.y}" stroke="${isMode2 ? '#2563eb' : '#4f46e5'}" stroke-width="${isMode2 ? '6' : '4.5'}" stroke-linecap="round" />
        <g class="pointer-events-none">
          <rect x="${(ptA.x + ptB.x)/2 - 38}" y="${(ptA.y + ptB.y)/2 + 8}" width="76" height="22" rx="6" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.2" />
          <text x="${(ptA.x + ptB.x)/2}" y="${(ptA.y + ptB.y)/2 + 23}" font-size="11" font-weight="extrabold" fill="#1d4ed8" text-anchor="middle">현 AB: ${chordLenCm}cm</text>
        </g>
      `;

      // Sector COD
      const pathCOD = `M ${CX} ${CY} L ${ptC.x} ${ptC.y} A ${R} ${R} 0 0 1 ${ptD.x} ${ptD.y} Z`;
      const codColor = isEqualOverlapActive ? '#d97706' : '#059669';
      const codDash = isEqualOverlapActive ? 'stroke-dasharray="5 3"' : '';
      layer.innerHTML += `
        <path d="${pathCOD}" fill="rgba(16, 185, 129, 0.25)" stroke="${codColor}" stroke-width="2" ${codDash} />
        <!-- 현 CD 선분 강조 -->
        <line x1="${ptC.x}" y1="${ptC.y}" x2="${ptD.x}" y2="${ptD.y}" stroke="${codColor}" stroke-width="${isMode2 ? '6' : '4.5'}" stroke-linecap="round" ${codDash} />
      `;

      if (!isEqualOverlapActive) {
        layer.innerHTML += `
          <g class="pointer-events-none">
            <rect x="${(ptC.x + ptD.x)/2 - 38}" y="${(ptC.y + ptD.y)/2 - 30}" width="76" height="22" rx="6" fill="#ecfdf5" stroke="#10b981" stroke-width="1.2" />
            <text x="${(ptC.x + ptD.x)/2}" y="${(ptC.y + ptD.y)/2 - 15}" font-size="11" font-weight="extrabold" fill="#047857" text-anchor="middle">현 CD: ${chordLenCm}cm</text>
          </g>
        `;
      }

      // Angle indicator arcs at center O
      const pArcA1 = polarToXY(CX, CY, 42, angA);
      const pArcA2 = polarToXY(CX, CY, 42, angB);
      layer.innerHTML += `
        <path d="M ${pArcA1.x} ${pArcA1.y} A 42 42 0 0 1 ${pArcA2.x} ${pArcA2.y}" fill="none" stroke="#4f46e5" stroke-width="2.5" />
        <text x="${CX + 58 * Math.cos((angA + angB)/2)}" y="${CY + 58 * Math.sin((angA + angB)/2) + 4}" font-size="12" font-weight="bold" fill="#4338ca" text-anchor="middle">${equalChordAngle}°</text>
      `;

      if (!isEqualOverlapActive) {
        const pArcC1 = polarToXY(CX, CY, 42, angC);
        const pArcC2 = polarToXY(CX, CY, 42, angD);
        layer.innerHTML += `
          <path d="M ${pArcC1.x} ${pArcC1.y} A 42 42 0 0 1 ${pArcC2.x} ${pArcC2.y}" fill="none" stroke="#059669" stroke-width="2.5" />
          <text x="${CX + 58 * Math.cos((angC + angD)/2)}" y="${CY + 58 * Math.sin((angC + angD)/2) + 4}" font-size="12" font-weight="bold" fill="#047857" text-anchor="middle">${equalChordAngle}°</text>
        `;
      }

      // 2번 모드일 때: 현의 길이가 같음(전제조건)을 알리는 연결 애니메이션 가이드 표시
      if (isMode2 && !isEqualOverlapActive) {
        layer.innerHTML += `
          <!-- 두 현의 길이가 같음을 직관적으로 보여주는 비교 배지 -->
          <g class="pointer-events-none animate-pulse">
            <rect x="120" y="65" width="160" height="30" rx="15" fill="rgba(5, 150, 105, 0.92)" />
            <text x="200" y="85" font-size="12" font-weight="extrabold" fill="#ffffff" text-anchor="middle">📏 현 AB ＝ 현 CD (${chordLenCm}cm)</text>
          </g>
        `;
      }

      // Point Dots & Labels
      const pts = [
        { label: 'A', pt: ptA, col: '#4f46e5' },
        { label: 'B', pt: ptB, col: '#4f46e5' },
        { label: 'C', pt: ptC, col: '#059669' },
        { label: 'D', pt: ptD, col: '#059669' }
      ];

      pts.forEach(p => {
        layer.innerHTML += `
          <circle cx="${p.pt.x}" cy="${p.pt.y}" r="6.5" fill="${p.col}" stroke="#ffffff" stroke-width="2" />
          <text x="${p.pt.x + (p.pt.x > CX ? 14 : -14)}" y="${p.pt.y + (p.pt.y > CY ? 16 : -10)}" font-size="15" font-weight="extrabold" fill="#0f172a" text-anchor="middle">${p.label}</text>
        `;
      });

      const abVal = document.getElementById('lengthABVal');
      const cdVal = document.getElementById('lengthCDVal');
      if (abVal) abVal.textContent = `${chordLenCm} cm`;
      if (cdVal) cdVal.textContent = `${chordLenCm} cm`;
    }


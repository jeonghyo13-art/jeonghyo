        btn.className = 'p-3 bg-slate-50 hover:bg-indigo-50 border border-slate-200 hover:border-indigo-400 rounded-xl font-bold text-xs text-left text-slate-700 transition flex items-center justify-between';
        btn.innerHTML = `<span>${opt.text}</span><span class="text-slate-300">○</span>`;
        btn.onclick = () => submitQuizAnswer(opt.correct, q.explain);
        optContainer.appendChild(btn);
      });
    }

    function submitQuizAnswer(isCorrect, explanation) {
      const alertBox = document.getElementById('quizAlert');
      if (isCorrect) {
        quizScore += 25;
        document.getElementById('quizScoreDisplay').textContent = `점수: ${quizScore}점`;
        alertBox.className = 'min-h-[44px] p-3 rounded-xl bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center gap-2 animate-pulse';
        alertBox.innerHTML = `<span>✓</span><span>정답! ${explanation}</span>`;

        setTimeout(() => {
          if (quizIdx < quizData.length - 1) {
            quizIdx++;
            renderQuiz();
          } else {
            showAppModal('퀴즈 마스터 달성! 🎓', `축하합니다! 원과 부채꼴의 정비례 성질을 완벽하게 이해했습니다. (최종 점수: ${quizScore}점)`, true);
            restartQuiz();
          }
        }, 1200);
      } else {
        alertBox.className = 'min-h-[44px] p-3 rounded-xl bg-rose-100 text-rose-800 text-xs font-bold flex items-center gap-2';
        alertBox.innerHTML = `<span>✕</span><span>아쉬워요! 다시 한 번 생각해 보세요.</span>`;
      }
    }

    function restartQuiz() {
      quizIdx = 0;
      quizScore = 0;
      renderQuiz();
    }

    window.addEventListener('load', () => {
      renderRotateCanvas();
      renderSlices();
      updateEqualChordSim(60);
      updateChordSim(45);
    });
  </script>
</body>
</html>

  <script>
    /* Global Constants & State (All Audio / Sound Engines Removed) */
    const CX = 200, CY = 200, R = 160;
    let currentTab = 'rotate';

    /* Polar Helper Function */
    function polarToXY(cx, cy, r, angleRad) {
      return {
        x: cx + r * Math.cos(angleRad),
        y: cy + r * Math.sin(angleRad)
      };
    }

    let rotateDeg = 0;
    const TARGET_OVERLAP_DEG = 115;
    const SECTOR_SPAN_DEG = 45;
    const BASE_SECTOR1_START = 180;
    const BASE_SECTOR2_START = 65;
    let isAutoRotating = false;
    let rotateAnimId = null;
    let isRotateConclusionUnlocked = false;

    function renderRotateCanvas() {
      const fixedLayer = document.getElementById('fixedSectorLayer');
      const rotLayer = document.getElementById('rotatingSectorLayer');
      const badgeLayer = document.getElementById('overlapBadgeLayer');
      if (!fixedLayer || !rotLayer || !badgeLayer) return;

      fixedLayer.innerHTML = '';
      rotLayer.innerHTML = '';
      badgeLayer.innerHTML = '';

      const toRad = deg => (deg * Math.PI) / 180;

      // 1. Fixed Sector 1 (기준 부채꼴: 180° ~ 225°)
      const s1Start = toRad(BASE_SECTOR1_START);
      const s1End = toRad(BASE_SECTOR1_START + SECTOR_SPAN_DEG);
      const p1Start = polarToXY(CX, CY, R, s1Start);
      const p1End = polarToXY(CX, CY, R, s1End);

      const pathSector1 = `M ${CX} ${CY} L ${p1Start.x} ${p1Start.y} A ${R} ${R} 0 0 1 ${p1End.x} ${p1End.y} Z`;
      fixedLayer.innerHTML = `
        <path d="${pathSector1}" fill="rgba(244, 63, 94, 0.28)" stroke="#f43f5e" stroke-width="2.5" />
        <text x="${(CX + p1Start.x + p1End.x)/3 - 10}" y="${(CY + p1Start.y + p1End.y)/3 + 6}" font-size="13" font-weight="bold" fill="#e11d48">부채꼴 1 (45°)</text>
      `;

      // 2. Rotating Sector 2
      const currentStartDeg = BASE_SECTOR2_START + rotateDeg;
      const s2Start = toRad(currentStartDeg);
      const s2End = toRad(currentStartDeg + SECTOR_SPAN_DEG);
      const p2Start = polarToXY(CX, CY, R, s2Start);
      const p2End = polarToXY(CX, CY, R, s2End);

      const isOverlapped = Math.abs(rotateDeg - TARGET_OVERLAP_DEG) < 1.5;
      const pathSector2 = `M ${CX} ${CY} L ${p2Start.x} ${p2Start.y} A ${R} ${R} 0 0 1 ${p2End.x} ${p2End.y} Z`;
      const rotColor = isOverlapped ? '#4f46e5' : '#6366f1';
      const rotFill = isOverlapped ? 'rgba(79, 70, 229, 0.45)' : 'rgba(99, 102, 241, 0.35)';

      rotLayer.innerHTML = `
        <path d="${pathSector2}" fill="${rotFill}" stroke="${rotColor}" stroke-width="${isOverlapped ? 3.5 : 2.5}" stroke-dasharray="${isOverlapped ? 'none' : '4 2'}" />
      `;

      if (rotateDeg < TARGET_OVERLAP_DEG - 2) {
        const arrowR = R * 0.75;
        const arrowStart = toRad(BASE_SECTOR2_START + SECTOR_SPAN_DEG / 2 + rotateDeg);
        const arrowEnd = toRad(BASE_SECTOR1_START + SECTOR_SPAN_DEG / 2);
        const pArr1 = polarToXY(CX, CY, arrowR, arrowStart);
        const pArr2 = polarToXY(CX, CY, arrowR, arrowEnd);
        rotLayer.innerHTML += `
          <path d="M ${pArr1.x} ${pArr1.y} A ${arrowR} ${arrowR} 0 0 1 ${pArr2.x} ${pArr2.y}" fill="none" stroke="#e11d48" stroke-width="2" stroke-dasharray="4 3" opacity="0.6"/>
        `;
      }

      // Update UI cards
      const statusTitle = document.getElementById('overlapStatusTitle');
      const cardArc = document.getElementById('checkArcCard');
      const badgeArc = document.getElementById('checkArcBadge');
      const cardArea = document.getElementById('checkAreaCard');
      const badgeArea = document.getElementById('checkAreaBadge');

      const lockBadge = document.getElementById('rotateLockBadge');
      const lockTitle = document.getElementById('rotateLockTitle');
      const lockDesc = document.getElementById('rotateLockDesc');
      const btnUnlock = document.getElementById('btnUnlockRotate');
      const btnUnlockText = document.getElementById('btnUnlockRotateText');

      if (isOverlapped) {
        statusTitle.innerHTML = `<span class="text-indigo-600 font-extrabold animate-bounce inline-block">✨ 완벽하게 딱 포개어졌습니다!</span>`;
        badgeArc.className = 'text-xs font-extrabold text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full';
        badgeArc.innerHTML = '&check; 호의 길이 일치!';
        badgeArea.className = 'text-xs font-extrabold text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full';
        badgeArea.innerHTML = '&check; 부채꼴 넓이 일치!';

        cardArc.className = 'bg-emerald-50 p-2.5 rounded-xl border border-emerald-300 flex items-center justify-between shadow-xs transition';
        cardArea.className = 'bg-emerald-50 p-2.5 rounded-xl border border-emerald-300 flex items-center justify-between shadow-xs transition';

        badgeLayer.innerHTML = `
          <g class="animate-pulse">
            <rect x="120" y="70" width="160" height="32" rx="16" fill="rgba(16, 185, 129, 0.95)" />
            <text x="200" y="91" font-size="13" font-weight="extrabold" fill="#ffffff" text-anchor="middle">🎯 100% 완전 일치 (합동)</text>
          </g>
        `;

        if (!isRotateConclusionUnlocked && btnUnlock) {
          lockBadge.className = 'text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full animate-bounce';
          lockBadge.textContent = '포개기 완료! 🔓';
          lockTitle.innerHTML = '✨ 두 부채꼴이 완전히 포개어졌습니다!';
          lockDesc.innerHTML = '아래 버튼을 눌러 <strong>두 부채꼴의 호와 넓이에 대한 공식</strong>을 확인하세요.';
          btnUnlock.disabled = false;
          btnUnlock.className = 'mt-1 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md cursor-pointer transition flex items-center gap-1.5 animate-pulse';
          btnUnlockText.textContent = '핵심 원리 확인하기 🔓';
        }
      } else {
        const percent = Math.round((rotateDeg / TARGET_OVERLAP_DEG) * 100);
        statusTitle.innerHTML = `회전 진행률: <span class="text-indigo-600 font-bold">${percent}%</span> (포개는 중)`;
        badgeArc.className = 'text-xs font-extrabold text-slate-400';
        badgeArc.textContent = '회전하여 포개어보세요';
        badgeArea.className = 'text-xs font-extrabold text-slate-400';
        badgeArea.textContent = '회전하여 포개어보세요';

        cardArc.className = 'bg-white p-2.5 rounded-xl border border-slate-200 flex items-center justify-between shadow-xs transition';
        cardArea.className = 'bg-white p-2.5 rounded-xl border border-slate-200 flex items-center justify-between shadow-xs transition';

        if (!isRotateConclusionUnlocked && btnUnlock) {
          lockBadge.className = 'text-[11px] font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full';
          lockBadge.textContent = '포개기 대기 중 🔒';
          lockTitle.innerHTML = '핵심 원리가 잠겨있어요! 🔒';
          lockDesc.innerHTML = '왼쪽 슬라이더나 <strong>[빙글 회전하여 포개기]</strong> 버튼으로<br>중심각이 같은 두 부채꼴을 먼저 <strong>100% 포개어 보세요!</strong>';
          btnUnlock.disabled = true;

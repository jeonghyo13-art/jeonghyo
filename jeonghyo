    function updateChordSim(degVal) {
      const singleDeg = parseFloat(degVal);
      const doubleDeg = singleDeg * 2;

      document.getElementById('chordAngleLabel').textContent = `${singleDeg}°`;
      document.getElementById('doubleAngleLabel').textContent = `${doubleDeg}°`;

      const layer = document.getElementById('chord-dynamic-layer');
      if (!layer) return;
      layer.innerHTML = '';

      const angB = Math.PI / 2;
      const angA = angB - (singleDeg * Math.PI) / 180;
      const angC = angB + (singleDeg * Math.PI) / 180;

      const ptB = polarToXY(CX, CY, R, angB);
      const ptA = polarToXY(CX, CY, R, angA);
      const ptC = polarToXY(CX, CY, R, angC);

      // Radii lines OA, OB, OC
      layer.innerHTML += `
        <line x1="${CX}" y1="${CY}" x2="${ptA.x}" y2="${ptA.y}" stroke="#94a3b8" stroke-width="2" />
        <line x1="${CX}" y1="${CY}" x2="${ptB.x}" y2="${ptB.y}" stroke="#94a3b8" stroke-width="2" stroke-dasharray="3 3" />
        <line x1="${CX}" y1="${CY}" x2="${ptC.x}" y2="${ptC.y}" stroke="#94a3b8" stroke-width="2" />
      `;

      // Angle indicators
      const pAngleA = polarToXY(CX, CY, 32, angA);
      const pAngleB = polarToXY(CX, CY, 32, angB);
      const pAngleC = polarToXY(CX, CY, 32, angC);
      layer.innerHTML += `
        <path d="M ${pAngleA.x} ${pAngleA.y} A 32 32 0 0 1 ${pAngleB.x} ${pAngleB.y}" fill="none" stroke="#6366f1" stroke-width="2.5" />
        <path d="M ${pAngleB.x} ${pAngleB.y} A 32 32 0 0 1 ${pAngleC.x} ${pAngleC.y}" fill="none" stroke="#6366f1" stroke-width="2.5" />
        <circle cx="${CX - 8}" cy="${CY + 22}" r="2" fill="#6366f1" />
        <circle cx="${CX + 8}" cy="${CY + 22}" r="2" fill="#6366f1" />
      `;

      // Chords
      layer.innerHTML += `
        <line x1="${ptA.x}" y1="${ptA.y}" x2="${ptB.x}" y2="${ptB.y}" stroke="#3b82f6" stroke-width="3.5" />
        <line x1="${ptB.x}" y1="${ptB.y}" x2="${ptC.x}" y2="${ptC.y}" stroke="#3b82f6" stroke-width="3.5" />
        <line x1="${ptA.x}" y1="${ptA.y}" x2="${ptC.x}" y2="${ptC.y}" stroke="#f59e0b" stroke-width="4.5" />
      `;

      // Arc AC
      layer.innerHTML += `
        <path d="M ${ptA.x} ${ptA.y} A ${R} ${R} 0 0 1 ${ptC.x} ${ptC.y}" fill="none" stroke="#10b981" stroke-width="5" stroke-linecap="round" />
      `;

      // Point markers
      const pts = [
        { label: 'A', pt: ptA, col: '#f59e0b' },
        { label: 'B', pt: ptB, col: '#3b82f6' },
        { label: 'C', pt: ptC, col: '#f59e0b' }
      ];

      pts.forEach(p => {
        layer.innerHTML += `
          <circle cx="${p.pt.x}" cy="${p.pt.y}" r="6.5" fill="${p.col}" stroke="#ffffff" stroke-width="2" />
          <text x="${p.pt.x + (p.pt.x > CX ? 14 : (p.pt.x < CX ? -14 : 0))}" y="${p.pt.y + 18}" font-size="16" font-weight="extrabold" fill="#0f172a" text-anchor="middle">${p.label}</text>
        `;
      });

      // Mathematical lengths
      const radSingle = (singleDeg * Math.PI) / 180;
      const radDouble = (doubleDeg * Math.PI) / 180;
      const chordAB = 2 * R * Math.sin(radSingle / 2);
      const chordAC = 2 * R * Math.sin(radDouble / 2);
      const chordRatio = (chordAC / chordAB).toFixed(2);

      document.getElementById('compArcVal').textContent = '정확히 2.00 배';
      document.getElementById('compChordVal').textContent = `${chordRatio} 배 (< 2배)`;
    }


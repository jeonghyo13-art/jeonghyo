    /* ========================================================== */
    /* CHAPTER 4: 중심각과 현의 관계 탐구 로직 (신설 및 2번 모드 강화) */
    /* ========================================================== */
    let equalChordAngle = 60;
    let equalChordMode = 'angleToChord'; // 'angleToChord' or 'chordToAngle'
    let isEqualOverlapActive = false;
    let isAngleAutoChanging = false;
    let angleChangeAnimId = null;

    function toggleAngleAutoChange() {
      const btn = document.getElementById('btnAutoAngleChange');
      const icon = document.getElementById('autoAngleIcon');
      const text = document.getElementById('autoAngleText');

      if (isAngleAutoChanging) {
        // 재생 중일 때 클릭 -> 일시 정지
        cancelAnimationFrame(angleChangeAnimId);
        isAngleAutoChanging = false;
        btn.className = equalChordMode === 'angleToChord' 
          ? 'px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs'
          : 'px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs';
        icon.textContent = '▶';
        text.textContent = equalChordMode === 'angleToChord' ? '각도 변화 계속 재생' : '현 변화 계속 재생';
        return;
      }

      // 이미 최대치(90도)에 도달해 있다면 처음(30도)부터 다시 시작
      if (equalChordAngle >= 90) {
        equalChordAngle = 30;
        const slider = document.getElementById('equalAngleSlider');
        if (slider) slider.value = 30;
        updateEqualChordSim(30);
      }

      isAngleAutoChanging = true;
      btn.className = 'px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs animate-pulse';
      icon.textContent = '⏸';
      text.textContent = equalChordMode === 'angleToChord' ? '각도 변화 일시정지' : '현 변화 일시정지';

      function stepAngle() {
        if (!isAngleAutoChanging) return;
        equalChordAngle += 0.5;

        // 최대 각도 90도 (최대 현의 길이 14.1cm)에 도달하면 정지
        if (equalChordAngle >= 90) {
          equalChordAngle = 90;
          const slider = document.getElementById('equalAngleSlider');
          if (slider) slider.value = 90;
          updateEqualChordSim(90);

          isAngleAutoChanging = false;
          btn.className = equalChordMode === 'angleToChord' 
            ? 'px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs'
            : 'px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs';
          icon.textContent = '↺';
          text.textContent = equalChordMode === 'angleToChord' ? '처음부터 다시 재생' : '처음부터 다시 재생';
          return;
        }

        const slider = document.getElementById('equalAngleSlider');
        if (slider) slider.value = Math.round(equalChordAngle);
        updateEqualChordSim(Math.round(equalChordAngle));
        angleChangeAnimId = requestAnimationFrame(stepAngle);
      }
      angleChangeAnimId = requestAnimationFrame(stepAngle);
    }

    function setEqualChordMode(mode) {
      if (isAngleAutoChanging) {
        toggleAngleAutoChange();
      }
      equalChordMode = mode;
      isEqualOverlapActive = false;
      const btnA = document.getElementById('btnModeAngle');
      const btnC = document.getElementById('btnModeChord');
      const controlTitle = document.getElementById('equalControlTitle');

      const topBadgeWrap = document.getElementById('topValueBadgeWrap');
      const autoBtn = document.getElementById('btnAutoAngleChange');
      const autoText = document.getElementById('autoAngleText');

      if (mode === 'angleToChord') {
        if (btnA) btnA.className = 'px-2.5 py-1.5 text-xs font-bold rounded-lg bg-indigo-600 text-white shadow-2xs transition text-center';
        if (btnC) btnC.className = 'px-2.5 py-1.5 text-xs font-bold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition text-center';
        
        if (topIcon) topIcon.textContent = '📐';
        if (topLabel) topLabel.textContent = '중심각:';
        if (topBadgeWrap) topBadgeWrap.className = 'px-2.5 py-0.5 bg-indigo-50 border border-indigo-200 rounded-lg text-xs font-bold text-indigo-700 flex items-center gap-1 shadow-2xs';
        if (autoBtn) autoBtn.className = 'px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs';
        if (autoText) autoText.textContent = '각도 자동 변화';

        if (controlTitle) controlTitle.innerHTML = `두 부채꼴의 중심각 크기: <span id="equalAngleLabel" class="text-indigo-600 text-sm font-extrabold">${equalChordAngle}°</span>`;
        if (controlHint) controlHint.textContent = '슬라이더로 각도를 변경하면 두 현의 길이가 같아집니다';
        if (slider) {
          slider.min = "30";
          slider.max = "90";
          slider.step = "5";
          slider.value = equalChordAngle;
        }
        if (ticks) ticks.innerHTML = `<span>30°</span><span>45°</span><span>60°</span><span>75°</span><span>90°</span>`;

        showAppModal(
          '탐구 모드 1: 중심각 ➔ 현 같음 📐➔📏',
          '두 부채꼴의 중심각(∠AOB = ∠COD)을 먼저 똑같이 맞추면, SAS 합동에 의해 두 현의 길이(AB = CD)도 자동으로 완전히 같아집니다.',
          true
        );
      } else {
        if (btnC) btnC.className = 'px-2.5 py-1.5 text-xs font-bold rounded-lg bg-emerald-600 text-white shadow-2xs transition text-center';
        if (btnA) btnA.className = 'px-2.5 py-1.5 text-xs font-bold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition text-center';

        const curChordLen = (2 * 10 * Math.sin(((equalChordAngle * Math.PI) / 180) / 2)).toFixed(1);
        if (topIcon) topIcon.textContent = '📏';
        if (topLabel) topLabel.textContent = '현의 길이:';
        if (topBadgeWrap) topBadgeWrap.className = 'px-2.5 py-0.5 bg-emerald-50 border border-emerald-200 rounded-lg text-xs font-bold text-emerald-700 flex items-center gap-1 shadow-2xs';
        if (autoBtn) autoBtn.className = 'px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs';
        if (autoText) autoText.textContent = '현의 길이 자동 변화';

        if (controlTitle) controlTitle.innerHTML = `두 현의 길이(AB = CD) 조절: <span id="equalAngleLabel" class="text-emerald-600 text-sm font-extrabold">${curChordLen} cm</span>`;
        if (controlHint) controlHint.textContent = '현의 길이를 직접 늘리거나 줄여보세요! 중심각이 자동으로 일치합니다';
        if (slider) {
          slider.min = "30";
          slider.max = "90";
          slider.step = "5";
          slider.value = equalChordAngle;
        }

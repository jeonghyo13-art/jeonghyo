    let selectedSliceCount = 1;
    const sliceColors = [
      '#4f46e5', '#6366f1', '#06b6d4', '#10b981',
      '#84cc16', '#eab308', '#f97316', '#ef4444'
    ];
    const sliceLabels = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
    const exploredSlices = new Set([1]); // Track explored slice numbers
    let isFoldConclusionUnlocked = false;

    // 기본 1조각(45°)일 때의 기준 예시 숫자
    const BASE_ARC_CM = 3;   // 호의 길이 3cm
    const BASE_AREA_CM2 = 6; // 넓이 6cm²

    function renderSlices() {
      const container = document.getElementById('slicesContainer');
      const labelLayer = document.getElementById('sliceLabelsContainer');
      const letterLayer = document.getElementById('circleLetters');
      if (!container || !letterLayer) return;

      container.innerHTML = '';
      if (labelLayer) labelLayer.innerHTML = '';
      letterLayer.innerHTML = '';

      const sliceAngle = (2 * Math.PI) / 8;

      // Draw dashed reference spokes for 8 sectors
      for (let i = 0; i < 8; i++) {
        const ang = -Math.PI / 2 + i * sliceAngle;
        const p = polarToXY(CX, CY, R, ang);
        container.innerHTML += `
          <line x1="${CX}" y1="${CY}" x2="${p.x}" y2="${p.y}" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3" />
        `;

        const textPos = polarToXY(CX, CY, R + 18, ang);
        letterLayer.innerHTML += `
          <text x="${textPos.x}" y="${textPos.y + 5}" font-size="14" font-weight="bold" fill="#475569" text-anchor="middle">${sliceLabels[i]}</text>
        `;
      }

      // Draw active slices
      for (let i = 0; i < 8; i++) {
        const startAng = -Math.PI / 2 + i * sliceAngle;
        const endAng = startAng + sliceAngle;
        const p1 = polarToXY(CX, CY, R, startAng);
        const p2 = polarToXY(CX, CY, R, endAng);

        const isSelected = i < selectedSliceCount;
        const fillColor = isSelected ? sliceColors[i] : '#f1f5f9';
        const fillOpacity = isSelected ? '0.45' : '0.2';
        const strokeColor = isSelected ? sliceColors[i] : '#cbd5e1';
        const strokeWidth = isSelected ? '2.5' : '1';

        const pathData = `M ${CX} ${CY} L ${p1.x} ${p1.y} A ${R} ${R} 0 0 1 ${p2.x} ${p2.y} Z`;

        const sliceG = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        sliceG.setAttribute('class', 'pie-piece');
        sliceG.setAttribute('onclick', `setSliceCount(${i + 1})`);
        sliceG.innerHTML = `
          <path d="${pathData}" fill="${fillColor}" fill-opacity="${fillOpacity}" stroke="${strokeColor}" stroke-width="${strokeWidth}" />
        `;

        if (isSelected) {
          const midAng = (startAng + endAng) / 2;
          const labelPos = polarToXY(CX, CY, R * 0.55, midAng);
          sliceG.innerHTML += `
            <text x="${labelPos.x}" y="${labelPos.y + 4}" font-size="11" font-weight="extrabold" fill="#1e293b" text-anchor="middle">45°</text>
          `;
        }

        container.appendChild(sliceG);
      }

      // 캔버스 위에 현재 선택된 부채꼴 전체의 호 길이 및 넓이 예시 라벨 렌더링
      if (labelLayer) {
        const totalStartAng = -Math.PI / 2;
        const totalEndAng = totalStartAng + selectedSliceCount * sliceAngle;
        const midTotalAng = (totalStartAng + totalEndAng) / 2;

        const currentArcCm = BASE_ARC_CM * selectedSliceCount;
        const currentAreaCm2 = BASE_AREA_CM2 * selectedSliceCount;

        // 호 바깥쪽 라벨 좌표
        const arcLabelPos = polarToXY(CX, CY, R + 34, midTotalAng);
        // 부채꼴 면 내부 라벨 좌표
        const areaLabelPos = polarToXY(CX, CY, R * 0.78, midTotalAng);

        labelLayer.innerHTML = `
          <!-- 호의 길이 예시 라벨 배지 -->
          <g class="pointer-events-none drop-shadow-sm">
            <rect x="${arcLabelPos.x - 38}" y="${arcLabelPos.y - 12}" width="76" height="24" rx="6" fill="#fef3c7" stroke="#f59e0b" stroke-width="1.5" />
            <text x="${arcLabelPos.x}" y="${arcLabelPos.y + 4}" font-size="11" font-weight="extrabold" fill="#b45309" text-anchor="middle">
              호 ${currentArcCm} cm
            </text>
          </g>
          <!-- 부채꼴 넓이 예시 라벨 배지 -->
          <g class="pointer-events-none drop-shadow-sm">
            <rect x="${areaLabelPos.x - 38}" y="${areaLabelPos.y - 12}" width="76" height="24" rx="6" fill="rgba(255, 255, 255, 0.92)" stroke="#10b981" stroke-width="1.5" />
            <text x="${areaLabelPos.x}" y="${areaLabelPos.y + 4}" font-size="11" font-weight="extrabold" fill="#047857" text-anchor="middle">
              넓이 ${currentAreaCm2} cm²
            </text>
          </g>
        `;
      }
    }

    function setSliceCount(val) {
      selectedSliceCount = parseInt(val, 10);
      document.getElementById('sliceSlider').value = selectedSliceCount;

      // Track explored slices
      exploredSlices.add(selectedSliceCount);
      updateFoldExplorationProgress();

      const totalAngle = selectedSliceCount * 45;
      const currentArcCm = BASE_ARC_CM * selectedSliceCount;
      const currentAreaCm2 = BASE_AREA_CM2 * selectedSliceCount;

      document.getElementById('sliceCountBadge').textContent = `${selectedSliceCount}조각 (${totalAngle}°)`;
      document.getElementById('kMultiplier').textContent = `${selectedSliceCount}배`;

      document.getElementById('metricAngle').textContent = `${totalAngle}°`;
      document.getElementById('metricAngleRatio').textContent = `(45° × ${selectedSliceCount} = 360° ÷ 8 × ${selectedSliceCount})`;

      document.getElementById('metricArc').textContent = `${currentArcCm} cm`;
      document.getElementById('metricArcRatio').innerHTML = `(3 cm × ${selectedSliceCount}배 / ${selectedSliceCount} l)`;

      document.getElementById('metricArea').textContent = `${currentAreaCm2} cm²`;
      document.getElementById('metricAreaRatio').textContent = `(6 cm² × ${selectedSliceCount}배 / ${selectedSliceCount} S)`;

      renderSlices();
    }

